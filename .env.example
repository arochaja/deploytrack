# Copy to .env and edit. Every setting is optional; defaults are safe for a demo.

TEAM_NAME=UWF Tech Team
TEAM_EMAIL=uwftech@uw.edu
BOOKINGS_URL=https://outlook.office.com/bookwithme/REPLACE_ME
EMAIL_DOMAIN=uw.edu

# Demo mode: uses data/demo.db (fake people, resettable) and shows "simulate booking" buttons.
# Set to false to use your real tracker data in data/deploytrack.db.
DEMO_MODE=true

# --- Email -------------------------------------------------------------
# outbox = save emails in the app only (nothing is sent). smtp = really send.
EMAIL_MODE=outbox
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# While testing with real data, send EVERY email to yourself instead:
REDIRECT_ALL_EMAIL_TO=

# --- ServiceNow --------------------------------------------------------
# manual = a "create ticket" to-do with prefilled text; you paste back the REQ#.
# email  = also email the ticket request to an intake address (check this is how your queue works first).
SNOW_MODE=manual
SNOW_INBOUND_EMAIL=help@uw.edu

# --- Reminders ---------------------------------------------------------
REMINDER_INTERVAL_DAYS=3
MAX_REMINDERS=2
REMINDER_CHECK_MINUTES=60

# --- Security ----------------------------------------------------------
# Set before exposing the app beyond your own machine. Purple and the UI send it as X-API-Key.
API_KEY=
# Shared secret the Power Automate flow sends as X-Webhook-Secret.
BOOKINGS_WEBHOOK_SECRET=

# --- AI: Purple (NebulaOne) --------------------------------------------
# offline = built-in rules, no AI (labelled "AI: offline rules" in the UI)
# claude  = Anthropic's Claude API (see the Claude block below)
# openai  = OpenAI-style chat completions API. Fill the rest in from NebulaOne's
#           "API reference" (Access Tokens page -> API reference button).
AI_PROVIDER=offline
AI_NAME=Purple
# Base URL of the API, e.g. https://<your-nebulaone-host>/api/v1  (no trailing slash)
AI_BASE_URL=
# Path appended to the base URL for chat
AI_CHAT_PATH=/chat/completions
# Personal access token from Access Tokens -> New Token. Keep it secret; it acts as you.
AI_TOKEN=
# Model name as NebulaOne lists it (leave blank if it picks a default)
AI_MODEL=
# How the token is sent. Most APIs: "Authorization: Bearer <token>".
# For an "api-key: <token>" style header: AI_AUTH_HEADER=api-key and AI_AUTH_PREFIX= (empty)
AI_AUTH_HEADER=Authorization
AI_AUTH_PREFIX=Bearer

# --- AI: Claude (works today, no admin needed) --------------------------
# Needs an API key from https://console.anthropic.com -> API Keys. This is billed
# separately from a Claude.ai Pro/Max/Team subscription; a subscription alone has no API key.
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high: how much the model thinks before answering
CLAUDE_EFFORT=medium
